# --- Server -----------------------------------------------------------------

PORT=5000
CORS_ORIGINS="http://localhost:3000,https://aws-nest-next-ai-file-reader.vercel.app"

# --- From Terraform ---------------------------------------------------------
# terraform -chdir=../../infra/terraform output -raw env_snippet
#
# AWS credentials are not set here. The SDK's default chain picks up your
# `aws configure` profile locally and the task role when deployed.

AWS_REGION=
S3_BUCKET_NAME=
DYNAMODB_TABLE_NAME=

# --- Secrets ----------------------------------------------------------------

GEMINI_API_KEY=
PINECONE_API_KEY=

# --- Shared with the ingestion pipeline -------------------------------------
#
# These three MUST be identical to the values in infra/serverless/.env.
#
# The pipeline embeds the document; this API embeds the user's question.
# Vectors from different models occupy different spaces, so a mismatch does
# not error -- Pinecone returns nearest neighbours that mean nothing, and the
# bot answers from irrelevant passages. Change them together.
#
# Switched from OpenAI to Gemini for quota headroom. gemini-embedding-2
# supports outputDimensionality, so 1536 is preserved and the existing
# Pinecone index does not need recreating -- but vectors indexed by the old
# OpenAI model are in a different space and must be deleted and re-uploaded.

GEMINI_EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=1536
PINECONE_INDEX_NAME=pdf-rag-index

# Model used to answer questions from the retrieved chunks. flash-lite: this is
# a simple RAG completion, not a task that needs the newest reasoning model,
# and it has meaningfully higher available quota than the newer -flash tiers.
GEMINI_CHAT_MODEL=gemini-flash-lite-latest
