# Copy to .env. Never committed.

# --- From Terraform ---------------------------------------------------------
# terraform -chdir=../terraform output -raw env_snippet

AWS_REGION=
S3_BUCKET_NAME=
DYNAMODB_TABLE_NAME=

# --- Secrets ----------------------------------------------------------------

OPENAI_API_KEY=
PINECONE_API_KEY=

# --- Shared with the API ----------------------------------------------------
#
# These three MUST be identical to the values in apps/api/.env.
#
# The pipeline embeds the document here; the API embeds the user's question.
# Vectors from different models occupy different spaces, so a mismatch does
# not error -- Pinecone happily returns nearest neighbours that mean nothing,
# and the bot answers from irrelevant passages. Change them together.

OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
PINECONE_INDEX_NAME=pdf-rag-index
